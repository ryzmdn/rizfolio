# Server Port
PORT=3007

# Database Connection (PostgreSQL with Drizzle ORM)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Authentication & Session Security (Min 32 characters)
CMS_OWNER_EMAIL="owner@example.com"
CMS_OWNER_PASSWORD="your-strong-password"
CMS_SESSION_SECRET="your-32-char-random-secret-key-for-jwt"

# Machine-to-Machine Master API Key
API_MASTER_KEY="rz_live_master_key_for_internal_services"

# Cache Revalidation Secret Token
REVALIDATION_SECRET_TOKEN="your-secret-token-for-revalidation"

# Supabase Storage & Services
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Monorepo Frontend Application URLs (for CORS Origin Whitelist)
NEXT_PUBLIC_PORTFOLIO_URL="https://portfolio.ryzmdn.me"
NEXT_PUBLIC_BLOG_URL="https://blog.ryzmdn.me"
NEXT_PUBLIC_SHOP_URL="https://shop.ryzmdn.me"
NEXT_PUBLIC_CHANGELOG_URL="https://changelog.ryzmdn.me"
NEXT_PUBLIC_DOCS_URL="https://docs.ryzmdn.me"
NEXT_PUBLIC_ARCHIVE_URL="https://archive.ryzmdn.me"
NEXT_PUBLIC_CMS_URL="https://cms.ryzmdn.me"
NEXT_PUBLIC_LINKBIO_URL="https://linkbio.ryzmdn.me"
NEXT_PUBLIC_API_URL="https://api.ryzmdn.me"
NEXT_PUBLIC_APP_URL="https://ryzmdn.me"

# Stripe Commerce (Optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
