# ==============================================================================
# RIZFOLIO MONOREPO ENVIRONMENT TEMPLATE
# ==============================================================================
# Duplicate this file to .env or .env.local for local development.
# IMPORTANT: Never commit actual credentials or secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM CONFIGURATION (Supabase PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
# Pooled connection string (Port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Direct connection string (Port 5432) for Drizzle migrations / studio
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & STORAGE BUCKETS
# ------------------------------------------------------------------------------
# Public API endpoint and anonymous key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service role key (strictly server-side only for admin/storage operations)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. CMS AUTHENTICATION & SESSION GUARD (Owner Only)
# ------------------------------------------------------------------------------
# Email address authorized to access CMS dashboard
CMS_OWNER_EMAIL="owner@domain.dev"

# Secure password for initial CMS owner provisioning
CMS_OWNER_PASSWORD="your-strong-owner-password"

# Random secret key for signing JWT session tokens (minimum 32 characters)
CMS_SESSION_SECRET="generate-a-strong-random-session-secret-min-32-chars"

# ------------------------------------------------------------------------------
# 4. ON-DEMAND ISR CACHE REVALIDATION
# ------------------------------------------------------------------------------
# Shared secret token for header-only ISR API revalidation (/api/revalidate)
REVALIDATION_SECRET_TOKEN="generate-a-strong-revalidation-secret-token-32-chars"

# ------------------------------------------------------------------------------
# 5. APPLICATION DOMAIN & SERVICE URLS (Local Port Defaults)
# ------------------------------------------------------------------------------
# Fallback base URL for sitemap & robots metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public consumer & dashboard app URLs
NEXT_PUBLIC_PORTFOLIO_URL="http://localhost:3000"
NEXT_PUBLIC_BLOG_URL="http://localhost:3001"
NEXT_PUBLIC_SHOP_URL="http://localhost:3002"
NEXT_PUBLIC_CHANGELOG_URL="http://localhost:3003"
NEXT_PUBLIC_CMS_URL="http://localhost:3004"
NEXT_PUBLIC_DOCS_URL="http://localhost:3005"
NEXT_PUBLIC_LINKBIO_URL="http://localhost:3006"

# Backward compatibility alias for docs
NEXT_PUBLIC_ARCHIVE_URL="http://localhost:3005"
