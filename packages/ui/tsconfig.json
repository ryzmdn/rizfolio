{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui": ["./src/index.ts"],
      "@workspace/ui/*": ["./src/*"],
      "@workspace/db": ["../db/src/index.ts"],
      "@workspace/db/*": ["../db/src/*"],
      "@workspace/auth": ["../auth/src/index.ts"],
      "@workspace/auth/*": ["../auth/src/*"],
      "@workspace/storage": ["../storage/src/index.ts"],
      "@workspace/storage/*": ["../storage/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
